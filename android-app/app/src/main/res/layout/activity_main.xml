<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Windmi"
            android:textColor="#E0E0E6"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sigMqtt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1A1A1F"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="MQTT"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sigMb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#1A1A1F"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="MB"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#24242B" />

    <TextView
        android:id="@+id/faultBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#33FF453A"
        android:padding="12dp"
        android:textColor="#FFD60A"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#24242B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1F"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Domů"
            android:textColor="#0A84FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Nastavení"
            android:textColor="#8E8E93"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
